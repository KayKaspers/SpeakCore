// SpeakCore – Prisma Schema (NDF Step 003)
// Auth-/Setup-Grundlage. SQLite ist der Standard für 0.1 (ADR-0002/0003).
// Bewusst KEINE komplexe Rechteverwaltung über OWNER hinaus.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Lokaler Account. In 0.1 existiert genau ein OWNER (im Setup-Wizard erstellt).
/// Passwort wird NUR als Argon2id-Hash gespeichert (ADR-0006).
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  displayName  String?
  passwordHash String
  role         String    @default("OWNER")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

/// Server-seitige Sitzung. Es wird NICHT der Roh-Token gespeichert, sondern dessen
/// HMAC-Hash (Schlüssel = SESSION_SECRET). Der Roh-Token liegt nur im HttpOnly-Cookie.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Schlüssel-Wert-Einstellungen (z. B. Setup-Status, Systemmodus simple/expert).
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

/// Audit-Log wichtiger Aktionen (z. B. Owner-Erstellung, Setup-Abschluss, Login/Logout).
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actor     String
  target    String?
  result    String   @default("success")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Rate-Limiting-Treffer (z. B. Login-Fehlversuche). Sliding-Window über `createdAt`.
/// SQLite-basiert (Single-Node-MVP); persistent über Neustarts. Siehe ADR-0014.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Verwaltete Serverinstanz. 0.1: ausschließlich type = "teamspeak3".
/// In Step 003 noch ungenutzt (keine TS3-Anbindung) – nur Schema-Vorbereitung.
model ServerInstance {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("teamspeak3")
  runState  String   @default("unknown")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
