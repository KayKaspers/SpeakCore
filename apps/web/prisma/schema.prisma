// SpeakCore – Prisma Schema (NDF Step 003)
// Auth-/Setup-Grundlage. SQLite ist der Standard für 0.1 (ADR-0002/0003).
// Bewusst KEINE komplexe Rechteverwaltung über OWNER hinaus.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Lokaler Account. In 0.1 existiert genau ein OWNER (im Setup-Wizard erstellt).
/// Passwort wird NUR als Argon2id-Hash gespeichert (ADR-0006).
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  displayName  String?
  passwordHash String
  role         String    @default("OWNER")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

/// Server-seitige Sitzung. Es wird NICHT der Roh-Token gespeichert, sondern dessen
/// HMAC-Hash (Schlüssel = SESSION_SECRET). Der Roh-Token liegt nur im HttpOnly-Cookie.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Schlüssel-Wert-Einstellungen (z. B. Setup-Status, Systemmodus simple/expert).
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

/// Audit-Log wichtiger Aktionen (z. B. Owner-Erstellung, Setup-Abschluss, Login/Logout).
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actor     String
  target    String?
  result    String   @default("success")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Rate-Limiting-Treffer (z. B. Login-Fehlversuche). Sliding-Window über `createdAt`.
/// SQLite-basiert (Single-Node-MVP); persistent über Neustarts. Siehe ADR-0014.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Verwaltete Serverinstanz. 0.1: type = "teamspeak3".
/// Step 008: `mode = "external"` = bestehender, read-only verbundener TS3-Server.
model ServerInstance {
  id              String            @id @default(cuid())
  name            String
  type            String            @default("teamspeak3")
  // "external" = read-only verbundener Server (Step 008/009);
  // "managed"  = von SpeakCore vorbereitete Ressourcen (Step 014; noch KEIN Container).
  mode            String            @default("external")
  host            String?
  queryPort       Int?
  voicePort       Int?
  fileTransferPort Int?
  virtualServerId Int?
  runState        String            @default("unknown")
  lastConnectedAt DateTime?
  // Managed-Provisioning-State (Step 014). KEINE Secrets, keine Roh-Agent-/Docker-Daten.
  instanceId               String?   @unique
  provisioningStatus       String? // DRAFT | RESOURCES_PREPARED | RESOURCE_PREPARE_PARTIAL | RESOURCE_PREPARE_FAILED | CONTAINER_PENDING | CONTAINER_CREATED | RUNNING | ERROR
  managedNetworkName       String?
  managedVolumeName        String?
  managedContainerName     String?
  lastProvisioningStep     String?
  lastProvisioningErrorKey String?
  resourcesPreparedAt      DateTime?
  managedVolumeState       String? // null = vorhanden/unbekannt | "removed" (Datenvolume entfernt, Step 025)
  // Persistierter read-only Status-Snapshot (Step 009). KEINE Secrets, keine Roh-Antworten.
  lastStatus          String?   // "reachable" | "unreachable"
  lastStatusCheckedAt DateTime?
  statusMessageKey    String? // generischer i18n-Fehlerschlüssel, null wenn erreichbar
  statusName          String?
  statusVersion       String?
  statusPlatform      String?
  statusClientsOnline Int?
  statusMaxClients    Int?
  statusUptimeSeconds Int?
  // Read-only Healthcheck-Ist-Zustand (Step 019). Getrennt vom Lifecycle-Status (provisioningStatus).
  // KEINE Roh-Docker-/TS3-Ausgaben, keine Secrets.
  lastHealthCheckedAt         DateTime?
  containerRuntimeStatus      String? // running | created | exited | notFound | conflict | unavailable | error
  ts3ReachabilityStatus       String? // reachable | unreachable | unknown | notConfigured
  lastHealthErrorKey          String?
  lastSuccessfulHealthCheckAt DateTime?
  credential          ServerCredential? @relation
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

/// Verschlüsselte ServerQuery-Zugangsdaten (AES-256-GCM, Schlüssel aus SECRET_ENCRYPTION_KEY).
/// NIEMALS im Klartext, nie im Log/Audit, nie im Client.
model ServerCredential {
  id                String         @id @default(cuid())
  serverInstanceId  String         @unique
  server            ServerInstance @relation(fields: [serverInstanceId], references: [id], onDelete: Cascade)
  encryptedUsername String
  encryptedPassword String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}
