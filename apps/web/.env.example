# --- apps/web – lokale Beispielkonfiguration (NDF Step 003) ---
# Kopiere nach apps/web/.env. KEINE echten Secrets committen.

# Prisma / SQLite – relativ zum Schema-Verzeichnis (apps/web/prisma) → apps/web/prisma/dev.db
DATABASE_URL="file:./dev.db"

# Session-Secret (mind. 16, empfohlen 32+ Zeichen). Zwingend setzen!
#   openssl rand -hex 32
SESSION_SECRET="change-me-generate-a-long-random-value"

# Schlüssel zur Verschlüsselung gespeicherter Secrets (z. B. TS3-Query-Zugangsdaten), AES-256-GCM.
# Mind. 16 Zeichen. Ohne diesen Schlüssel können keine Server-Zugangsdaten gespeichert werden.
#   openssl rand -hex 32
SECRET_ENCRYPTION_KEY="change-me-generate-a-long-random-value"

# Neuer Schlüssel NUR für die Rotation (NDF Step 016). Im Normalbetrieb leer lassen.
# Ablauf: DB-Backup anlegen, SECRET_ENCRYPTION_KEY_NEW setzen, dann als Operator ausführen:
#   pnpm --filter @speakcore/web rotate-secrets --dry-run   # nur Zählwerte, keine Änderung
#   pnpm --filter @speakcore/web rotate-secrets             # schreibt neu verschlüsselte Werte
# Danach SECRET_ENCRYPTION_KEY := neuer Wert setzen und SECRET_ENCRYPTION_KEY_NEW wieder leeren.
# Es gibt bewusst KEINE Web-UI/API dafür. Secrets werden nie ausgegeben.
SECRET_ENCRYPTION_KEY_NEW=

# Setup-Sperre: auf "true" setzen, um die Owner-Erstellung dauerhaft zu sperren
# (z. B. nach abgeschlossenem Setup in produktiven Deployments). Leer/false = entsperrt.
SETUP_LOCK=

# Öffentliche Basis-URL der App (für absolute Links/Metadaten).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vorschlag für die Query-Adresse managed TS3-Server (NDF Step 020) – nur read-only Healthcheck.
# Wird im Provisioning-Formular vorbelegt und kann dort überschrieben werden. Leer lassen = keine
# Adresse (Healthcheck bleibt "notConfigured"). KEIN Portscan, KEINE automatische IP-Ermittlung.
#   z. B. 127.0.0.1 (Web-App auf demselben Host) oder die Docker-Host-Adresse.
MANAGED_TS3_QUERY_HOST=

# --- Verbindung Web → SpeakCore Agent (nur serverseitig; NIE an den Browser) ---
# Basis-URL des Agents. Leer/fehlend = kein Agent (Systemcheck/Provisioning nutzen Fallback/Fehlerpfade).
# Den Agent NUR im privaten Netz betreiben, nie öffentlich exponieren.
AGENT_URL="http://localhost:4000"

# Bootstrap-Token des Agents (muss mit apps/agent AGENT_BOOTSTRAP_TOKEN übereinstimmen). Nur serverseitig
# verwendet (Authorization: Bearer). In Produktion generieren: `openssl rand -hex 32`. Nie committen.
AGENT_BOOTSTRAP_TOKEN="example-bootstrap-token-change-me"

# HINWEIS: Docker-Schreibaktionen (create/start/stop/rm, volume rm, network rm) sind im AGENT hinter
# AGENT_DOCKER_WRITE_ENABLED (Default false) + Token gekapselt – siehe apps/agent/.env.example.
