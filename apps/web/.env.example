# --- apps/web – lokale Beispielkonfiguration (NDF Step 003) ---
# Kopiere nach apps/web/.env. KEINE echten Secrets committen.

# Prisma / SQLite – relativ zum Schema-Verzeichnis (apps/web/prisma) → apps/web/prisma/dev.db
DATABASE_URL="file:./dev.db"

# Session-Secret (mind. 16, empfohlen 32+ Zeichen). Zwingend setzen!
#   openssl rand -hex 32
SESSION_SECRET="change-me-generate-a-long-random-value"

# Setup-Sperre: auf "true" setzen, um die Owner-Erstellung dauerhaft zu sperren
# (z. B. nach abgeschlossenem Setup in produktiven Deployments). Leer/false = entsperrt.
SETUP_LOCK=

# Öffentliche Basis-URL der App (für absolute Links/Metadaten).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
