# --- apps/web – lokale Beispielkonfiguration (NDF Step 002) ---
# Kopiere nach apps/web/.env. KEINE echten Secrets committen.

# Prisma / SQLite – relativ zum Verzeichnis apps/web
DATABASE_URL="file:./prisma/dev.db"

# Session-Secret der WebUI (langer Zufallswert, z. B. `openssl rand -hex 32`)
SESSION_SECRET="change-me-generate-a-long-random-value"

# Verbindung zum SpeakCore Agent
AGENT_URL="http://localhost:4000"
AGENT_BOOTSTRAP_TOKEN="example-bootstrap-token-change-me"
