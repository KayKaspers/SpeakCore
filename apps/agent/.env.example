# --- apps/agent – Beispielkonfiguration (NDF Step 002) ---
# Kopiere nach apps/agent/.env. KEINE echten Secrets committen.

AGENT_PORT=4000

# Bootstrap-Token. Wenn gesetzt, ist es für ALLE nicht-Liveness-Endpunkte Pflicht (Snapshot, Inventar,
# Provisioning/Docker-Aktionen). Muss mit dem Web-Wert AGENT_BOOTSTRAP_TOKEN übereinstimmen.
# In Produktion generieren, z. B. `openssl rand -hex 32`. NIE committen. Agent nur im privaten Netz.
AGENT_BOOTSTRAP_TOKEN="example-bootstrap-token-change-me"

# Optional: Pfad, dessen freier Speicher im Snapshot gemeldet wird (Default: Arbeitsverzeichnis).
# AGENT_DATA_PATH=/data

# WARNUNG – Docker-Schreibaktionen freischalten (Default: false).
# Gilt für ALLE managed Write-Aktionen: Network/Volume anlegen, Container create/start/stop/rm,
# `docker volume rm`, `docker network rm` (jeweils Managed-Only, kein -f, hinter Token). Ist das Flag
# false, liefern alle Write-Endpunkte `writeDisabled` – SpeakCore fasst dann KEINE Docker-Ressourcen an.
# Nur aktivieren, wenn SpeakCore auf diesem Host managed TS3-Ressourcen verwalten darf.
# Es wird KEIN Docker-Socket in den Web-Container gemountet; der Agent nutzt die lokale Docker-CLI.
AGENT_DOCKER_WRITE_ENABLED=false
