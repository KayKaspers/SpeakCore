# --- apps/agent – Beispielkonfiguration (NDF Step 002) ---
# Kopiere nach apps/agent/.env. KEINE echten Secrets committen.

AGENT_PORT=4000

# Bootstrap-Token. Wenn gesetzt, erfordert GET /system/snapshot ein gültiges Bearer-Token.
# In Produktion generieren, z. B. `openssl rand -hex 32`.
AGENT_BOOTSTRAP_TOKEN="example-bootstrap-token-change-me"

# Optional: Pfad, dessen freier Speicher im Snapshot gemeldet wird (Default: Arbeitsverzeichnis).
# AGENT_DATA_PATH=/data
