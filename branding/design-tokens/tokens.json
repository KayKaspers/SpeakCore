{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "SpeakCore Design Tokens",
    "version": "0.1.0-draft",
    "status": "draft",
    "note": "Vorläufige Tokens (NDF Step 001). Quelle der Wahrheit für Farben, Typografie, Abstände. Finale Assets folgen."
  },
  "color": {
    "background":      { "value": "#0B1220", "type": "color" },
    "surface":         { "value": "#111827", "type": "color" },
    "primary":         { "value": "#2563EB", "type": "color", "comment": "Primary Blue" },
    "accent":          { "value": "#06B6D4", "type": "color", "comment": "Accent Cyan" },
    "success":         { "value": "#22C55E", "type": "color", "comment": "Ampel gruen" },
    "warning":         { "value": "#F59E0B", "type": "color", "comment": "Ampel gelb" },
    "error":           { "value": "#EF4444", "type": "color", "comment": "Ampel rot" },
    "text-primary":    { "value": "#F8FAFC", "type": "color" },
    "text-secondary":  { "value": "#94A3B8", "type": "color" }
  },
  "font": {
    "family-sans": { "value": "Inter, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif", "type": "fontFamily" },
    "family-mono": { "value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace", "type": "fontFamily" }
  },
  "fontSize": {
    "display": { "value": "2.25rem", "type": "dimension" },
    "h1":      { "value": "1.5rem",  "type": "dimension" },
    "h2":      { "value": "1.25rem", "type": "dimension" },
    "body":    { "value": "1rem",    "type": "dimension" },
    "sm":      { "value": "0.875rem","type": "dimension" },
    "caption": { "value": "0.75rem", "type": "dimension" }
  },
  "radius": {
    "sm": { "value": "0.375rem", "type": "dimension" },
    "md": { "value": "0.5rem",   "type": "dimension" },
    "lg": { "value": "0.75rem",  "type": "dimension" }
  },
  "space": {
    "1": { "value": "0.25rem", "type": "dimension" },
    "2": { "value": "0.5rem",  "type": "dimension" },
    "3": { "value": "0.75rem", "type": "dimension" },
    "4": { "value": "1rem",    "type": "dimension" },
    "6": { "value": "1.5rem",  "type": "dimension" },
    "8": { "value": "2rem",    "type": "dimension" }
  }
}
