{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "SpeakCore Design Tokens",
    "version": "0.2.0-draft",
    "status": "draft",
    "note": "Quelle der Wahrheit für Farben, Typografie, Abstände, Radius, Schatten, Z-Index und Motion. tokens.css und tailwind.tokens.js werden konsistent gehalten. Enterprise Dark."
  },
  "color": {
    "background":      { "value": "#0B1220", "type": "color", "comment": "App-Hintergrund" },
    "surface":         { "value": "#111827", "type": "color", "comment": "Karten/Panels" },
    "surface-raised":  { "value": "#1A2233", "type": "color", "comment": "erhöhte Flächen/Hover" },
    "border":          { "value": "#1F2937", "type": "color", "comment": "dezente Trennlinien" },
    "border-strong":   { "value": "#334155", "type": "color", "comment": "stärkere Ränder/Fokus-Umfeld" },
    "primary":         { "value": "#2563EB", "type": "color", "comment": "Primary Blue" },
    "primary-hover":   { "value": "#1D4ED8", "type": "color", "comment": "Primary Hover/Active" },
    "accent":          { "value": "#06B6D4", "type": "color", "comment": "Accent Cyan" },
    "info":            { "value": "#38BDF8", "type": "color", "comment": "informativ" },
    "success":         { "value": "#22C55E", "type": "color", "comment": "Ampel gruen" },
    "warning":         { "value": "#F59E0B", "type": "color", "comment": "Ampel gelb" },
    "error":           { "value": "#EF4444", "type": "color", "comment": "Ampel rot" },
    "text-primary":    { "value": "#F8FAFC", "type": "color" },
    "text-secondary":  { "value": "#94A3B8", "type": "color" },
    "text-muted":      { "value": "#64748B", "type": "color", "comment": "Hilfstexte/Disabled" },
    "ring":            { "value": "#2563EB", "type": "color", "comment": "Fokus-Ring" }
  },
  "font": {
    "family-sans": { "value": "Inter, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif", "type": "fontFamily" },
    "family-mono": { "value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace", "type": "fontFamily" }
  },
  "fontSize": {
    "display": { "value": "2.25rem", "type": "dimension" },
    "h1":      { "value": "1.5rem",  "type": "dimension" },
    "h2":      { "value": "1.25rem", "type": "dimension" },
    "body":    { "value": "1rem",    "type": "dimension" },
    "sm":      { "value": "0.875rem","type": "dimension" },
    "caption": { "value": "0.75rem", "type": "dimension" }
  },
  "radius": {
    "sm":   { "value": "0.375rem", "type": "dimension" },
    "md":   { "value": "0.5rem",   "type": "dimension" },
    "lg":   { "value": "0.75rem",  "type": "dimension" },
    "xl":   { "value": "1rem",     "type": "dimension" },
    "full": { "value": "9999px",   "type": "dimension" }
  },
  "space": {
    "1": { "value": "0.25rem", "type": "dimension" },
    "2": { "value": "0.5rem",  "type": "dimension" },
    "3": { "value": "0.75rem", "type": "dimension" },
    "4": { "value": "1rem",    "type": "dimension" },
    "6": { "value": "1.5rem",  "type": "dimension" },
    "8": { "value": "2rem",    "type": "dimension" }
  },
  "shadow": {
    "sm": { "value": "0 1px 2px rgba(0, 0, 0, 0.40)",   "type": "shadow" },
    "md": { "value": "0 4px 12px rgba(0, 0, 0, 0.45)",  "type": "shadow" },
    "lg": { "value": "0 12px 32px rgba(0, 0, 0, 0.50)", "type": "shadow" }
  },
  "zIndex": {
    "base":     { "value": 0,    "type": "number" },
    "dropdown": { "value": 1000, "type": "number" },
    "sticky":   { "value": 1100, "type": "number" },
    "overlay":  { "value": 1200, "type": "number" },
    "modal":    { "value": 1300, "type": "number" },
    "toast":    { "value": 1400, "type": "number" }
  },
  "motion": {
    "duration-fast": { "value": "120ms", "type": "duration" },
    "duration-base": { "value": "200ms", "type": "duration" },
    "duration-slow": { "value": "320ms", "type": "duration" },
    "easing-standard":   { "value": "cubic-bezier(0.2, 0, 0, 1)", "type": "cubicBezier" },
    "easing-emphasized": { "value": "cubic-bezier(0.3, 0, 0, 1)", "type": "cubicBezier" }
  }
}
