# =========================================================================
#  SpeakCore Suite – Beispielkonfiguration (NDF Step 002)
#  KEINE echten Secrets committen. Kopiere diese Datei nach `.env`.
#  Secrets (Tokens, Session-Secret) immer mit Zufallswerten ersetzen.
# =========================================================================

# --- Web-App (SpeakCore WebUI + API) ---------------------------------------
WEB_PORT=3000

# Datenbank (SQLite – Standard für 0.1).
# Hinweis: Prisma in apps/web nutzt apps/web/.env (DATABASE_URL relativ zu apps/web).
# Dieser Wert wird im Docker-Compose-Kontext verwendet.
DATABASE_URL="file:/data/speakcore.db"

# Session-Secret der WebUI – generiere einen langen Zufallswert, z. B.:
#   openssl rand -hex 32
SESSION_SECRET="change-me-generate-a-long-random-value"

# --- Agent (SpeakCore Agent) ----------------------------------------------
AGENT_PORT=4000
# Von der Web-App genutzte Agent-URL (im Compose-Netz: http://agent:4000)
AGENT_URL="http://localhost:4000"

# Bootstrap-Token für die Authentifizierung API <-> Agent.
# In Produktion automatisch generieren – NICHT diesen Beispielwert nutzen.
#   openssl rand -hex 32
AGENT_BOOTSTRAP_TOKEN="example-bootstrap-token-change-me"

# --- Admin-Setup -----------------------------------------------------------
# Der erste Admin-Account wird im Setup-Wizard angelegt (keine Default-Passwörter).
ADMIN_SETUP_ENABLED=true
